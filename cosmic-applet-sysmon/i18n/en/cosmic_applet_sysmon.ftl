tip-idle = No graphs enabled
tip-cpu = CPU {$value}
tip-memory = Memory {$used} of {$total}
tip-network = Network: in {$rx}, out {$tx}
tip-swap = Swap {$used} of {$total}
tip-load = Load average {$value}
tip-disk = Disk: read {$read}, write {$write}

# The second line of each tooltip: what the graph above it actually measures.
# Same wording as the toggle on the settings page, so the two agree.
what-cpu = User, nice, system and iowait time, stacked to 100%.
what-memory = Used, buffers and cache, against total memory.
what-network = Received and sent bytes on every interface except loopback.
what-swap = Used against total swap.
what-load = Tasks waiting their turn, averaged over a minute. Not processor load.
what-disk = Bytes read and written on whole block devices.

size-b = {$value} B
size-kib = {$value} KiB
size-mib = {$value} MiB
size-gib = {$value} GiB

rate-b = {$value} B/s
rate-kib = {$value} KiB/s
rate-mib = {$value} MiB/s
