// WMDE applet settings schema. See .doc/settings/08-applet-schemas.md.
//
// Only the one key that has no interface anywhere else. The other five are edited on
// the Date & Time page, which owns the clock as a whole (since COSMIC 1.9 the day of the
// week is there too, in the applet drawer); duplicating them here would put a third
// writer into one config file.
(
    schema: 1,
    config: (id: "fun.wmde.AppletTime", version: 1),
    groups: [
        (
            title: { "": "Panel", "uk": "Панель" },
            rows: [
                Setting(
                    key: "format_strftime",
                    label: { "": "Custom format", "uk": "Власний формат" },
                    description: {
                        "": "strftime format, for example %H:%M. Empty means the default.",
                        "uk": "Формат strftime, наприклад %H:%M. Порожньо - типовий вигляд.",
                    },
                    control: Text(max_len: 64),
                    default: "\"\"",
                ),
                Link(page: "time-date", label: {
                    "": "Time zone, 24-hour clock, first day of the week, what the panel clock shows",
                    "uk": "Часовий пояс, 24-годинний формат, перший день тижня, вигляд годинника на панелі",
                }),
            ],
        ),
    ],
)
